# Variables pour lancer l'audit en local : copier en .env (non versionne) et renseigner les valeurs.
# Usage : node --env-file=.env --use-system-ca scripts/<script>.mjs
# Dans la routine cloud, ces variables sont declarees dans l'environnement « Default », pas ici.
AUDIT_TOKEN=
PROGRAMS_CSV_URL=
BREVO_API_KEY=
# Facultatif : remplace les destinataires de audit-config.json (separes par des virgules)
REPORT_TO=jcpoirot.consultant-externe@ketb.com
